PORT=3000
HOST=0.0.0.0
NODE_ENV=development

ADMIN_ID=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=change-this-super-secret-key
ADMIN_PAGE_PATH=/espace-admin-225
ADMIN_PAGE_KEY=change-this-private-key
PROMO_ENABLED=true
PROMO_TITLE_FR=Offre Flash -10% cette semaine
PROMO_TITLE_EN=Flash Deal -10% this week
PROMO_END_AT=2026-12-31T23:59:59+00:00

# En production avec disque persistant (Render, VPS, Docker volume) :
# PRODUCTS_FILE=/var/data/products.json

# Cloudinary — stockage permanent des images (gratuit sur cloudinary.com)
# Sans ces variables, les images sont stockées localement (perdues au redémarrage sur Render gratuit)
CLOUDINARY_CLOUD_NAME=ton_cloud_name
CLOUDINARY_API_KEY=ton_api_key
CLOUDINARY_API_SECRET=ton_api_secret
